import json

def parse_log(log):
    errors = 0
    warnings = 0
    battery_min_pct = 100
    zones_visited = 0
    anomalies = []
    for line in log.split('\n'):
        if line.startswith('ERROR'):
            errors += 1
            anomalies.append(line.split('ERROR')[1].split(':')[0])
        elif line.startswith('WARN'):
            warnings += 1
            anomalies.append(line.split('WARN')[1].split(':')[0])
        elif line.startswith('INFO'):
            if 'battery' in line:
                battery_pct = int(line.split('battery at')[1].split('%')[0])
                if battery_pct < battery_min_pct:
                    battery_min_pct = battery_pct
